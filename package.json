{
  "name": "linguagacha",
  "version": "0.0.0",
  "private": true,
  "description": "Next Generation AI translator for novels, games, subtitles, and more",
  "author": "neavo",
  "type": "module",
  "main": "build/dist-server/index.js",
  "scripts": {
    "build": "tsc -b --noEmit && vite build --config buildtools/vite/vite.config.ts",
    "build:server": "tsc -p tsconfig.node.json --outDir build/dist-server",
    "check": "node ./buildtools/check/index.mjs",
    "dev": "vite dev --config buildtools/vite/vite.config.ts",
    "format": "node ./buildtools/format-related-files.mjs",
    "lint": "oxlint .",
    "test": "vitest run --config buildtools/vitest/vitest.config.ts"
  },
